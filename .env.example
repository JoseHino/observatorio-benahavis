# Credenciales del Observatorio de Benahavís
# Copiar a .env y rellenar. El fichero .env NUNCA se sube al repositorio.
# En GitHub Actions estos valores se leen de Settings > Secrets and variables > Actions.

# AEMET OpenData — clave nominal gratuita.
# Se solicita en https://opendata.aemet.es/centrodedescargas/altaUsuario
# Sin ella, el bloque de clima queda vacío y marcado como pendiente (el pipeline no falla).
AEMET_API_KEY=

# Copernicus Climate Data Store — solo si se activa la descarga de reanálisis ERA5.
# Alta en https://cds.climate.copernicus.eu/
CDS_API_KEY=

# Copernicus Data Space Ecosystem — solo si se activa el cálculo de NDVI con Sentinel-2.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
